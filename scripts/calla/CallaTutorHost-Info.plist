<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- This is the executable TCC grants Screen Recording to, and it appeared
         in the Privacy pane as "Boring Calla Engine" — the same name as the XPC
         service beside it, so there was no way to tell which row to allow.
         CFBundleIdentifier is deliberately unchanged: TCC keys on it, and
         renaming it would discard a grant that has already been given. -->
    <key>CFBundleDisplayName</key>
    <string>Boring Notch Tutor</string>
    <key>CFBundleExecutable</key>
    <string>CallaTutorHost</string>
    <key>CFBundleIdentifier</key>
    <string>theboringteam.boringnotch.CallaTutorHost</string>
    <key>CFBundleName</key>
    <string>Boring Notch Tutor</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Calla Tutor captures only an allowed application window to guide your lesson.</string>
</dict>
</plist>
